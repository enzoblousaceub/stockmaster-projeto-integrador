# Copie para .env (ignorado pelo git) e troque a senha. Nunca commite o .env.
POSTGRES_USER=stockmaster
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=stockmaster

# Usada pelo backend em desenvolvimento (mesmos valores acima). O formato URL do Render tambem e aceito.
DATABASE_URL=postgresql://stockmaster:troque-esta-senha@localhost:5432/stockmaster

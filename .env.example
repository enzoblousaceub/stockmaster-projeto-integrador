# Copie para .env (ignorado pelo git) e troque a senha. Nunca commite o .env.
POSTGRES_USER=stockmaster
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=stockmaster

# Usada pelo backend em desenvolvimento (mesmos valores acima). O formato URL do Render tambem e aceito.
DATABASE_URL=postgresql://stockmaster:troque-esta-senha@localhost:5432/stockmaster

# Autenticacao (backend). Primeiro Admin criado no startup quando nao ha nenhum Admin ativo.
# Valores abaixo sao APENAS exemplo de desenvolvimento: em producao use segredo proprio, nunca estes.
Auth__AdminEmail=admin@exemplo.com
Auth__AdminSenha=dev-apenas-troque-me-123
# Chave HMAC dos codigos de ativacao (base64, >= 32 bytes). Em producao: gere uma nova (ex.: openssl rand -base64 48). Em Development ja ha uma chave de dev no appsettings.
# Auth__CodeHmacKey=
# Cifra as chaves de sessao gravadas no Postgres (base64, >= 32 bytes). Opcional em dev; OBRIGATORIA em producao.
# Auth__KeyEncryptionKey=
# Rodando o container em http://localhost (sem HTTPS)? Cookies Secure nao funcionam em HTTP simples:
# Auth__SecureCookies=false

# Usuario de teste (so em desenvolvimento: criado apenas com Seed:Enabled, que e true so em Development).
# Perfil: Visualizador (padrao) ou Admin. Valores APENAS de exemplo.
# Seed__TestEmail=teste@exemplo.com
# Seed__TestSenha=dev-teste-troque-me-123
# Seed__TestPerfil=Visualizador

# Convite por e-mail (Resend, https://resend.com). Sem estas variaveis o e-mail nao e enviado e o Admin ve o codigo na tela.
# Email__From precisa ser de um dominio verificado no Resend (para testes: onboarding@resend.dev, que so envia ao dono da conta).
# Email__ResendApiKey=
# Email__From=Stock Master <acesso@seu-dominio.com>
# URL publica do app, usada no link do e-mail (sem barra final).
# App__PublicBaseUrl=http://localhost:4200
